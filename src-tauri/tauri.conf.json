{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RodeBrowser",
  "version": "1.0.1",
  "identifier": "com.nanodev.rodebrowser",
  "build": {
    "frontendDist": "../src-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Rode Browser",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
